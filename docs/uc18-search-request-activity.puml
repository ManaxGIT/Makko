@startuml
!pragma layout smetana
title ACTIVITY DIAGRAM – TÌM KIẾM YÊU CẦU (UC18)

skinparam dpi 180
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam activity {
  BackgroundColor #F3FBF7
  BorderColor #2F8065
  FontColor #172033
  DiamondBackgroundColor #FFF7E8
  DiamondBorderColor #C17A1B
  StartColor #28775D
  EndColor #28775D
  BarColor #64748B
}
skinparam partition {
  BorderColor #94A3B8
  FontColor #24324A
  BackgroundColor #FBFCFE
}
skinparam ArrowColor #64748B
skinparam ArrowThickness 1.2

|Người nhận yêu cầu|
start
:Mở chức năng\n"Tìm kiếm yêu cầu";
:Chọn khu vực hoặc cho phép\nsử dụng vị trí hiện tại;
:Nhập điều kiện về khoảng cách,\nthời gian hoặc mức chi phí;

|Hệ thống|
:Kiểm tra tính hợp lệ\ncủa điều kiện tìm kiếm;

while (Điều kiện chưa hợp lệ?) is (Có)
  :Hiển thị nội dung cần điều chỉnh;
  |Người nhận yêu cầu|
  :Điều chỉnh điều kiện tìm kiếm;
  |Hệ thống|
  :Kiểm tra lại điều kiện;
endwhile (Không)

:Lấy các yêu cầu có trạng thái PENDING\nvà loại bỏ yêu cầu do chính người nhận đăng;

|Dịch vụ bản đồ|
:Xác định tọa độ và khoảng cách\ngiữa các địa điểm liên quan;

|Hệ thống|
:Lọc và sắp xếp các yêu cầu\ntheo điều kiện tìm kiếm;

if (Có yêu cầu phù hợp?) then (Không)
  |Hệ thống|
  :Thông báo không tìm thấy\nyêu cầu phù hợp;
  |Người nhận yêu cầu|
  :Thay đổi điều kiện hoặc\nkết thúc tìm kiếm;
  stop
else (Có)
  |Hệ thống|
  :Hiển thị danh sách yêu cầu cùng\nthông tin tóm tắt và khoảng cách;
  |Người nhận yêu cầu|
  :Xem danh sách kết quả;
  stop
endif

@enduml
