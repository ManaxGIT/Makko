@startuml
!pragma layout smetana
title ACTIVITY DIAGRAM – TÌM KIẾM VÀ NHẬN YÊU CẦU (UC18, UC09, UC19)

skinparam dpi 180
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam activity {
  BackgroundColor #F3FBF7
  BorderColor #2F8065
  FontColor #172033
  DiamondBackgroundColor #FFF7E8
  DiamondBorderColor #C17A1B
  StartColor #28775D
  EndColor #28775D
  BarColor #64748B
}
skinparam partition {
  BorderColor #94A3B8
  FontColor #24324A
  BackgroundColor #FBFCFE
}
skinparam ArrowColor #64748B
skinparam ArrowThickness 1.2

|Người nhận yêu cầu|
start
:Mở chức năng\n"Tìm kiếm yêu cầu";
:Nhập khu vực, khoảng cách,\nthời gian hoặc mức chi phí;

|Hệ thống|
:Lấy các yêu cầu có trạng thái PENDING\nvà loại bỏ yêu cầu do chính người nhận đăng;
:Lọc, sắp xếp và hiển thị\ndanh sách yêu cầu phù hợp;

|Người nhận yêu cầu|
:Chọn một yêu cầu;

|Hệ thống|
:Kiểm tra quyền truy cập và\nhiển thị thông tin chi tiết (UC09);

|Người nhận yêu cầu|
if (Muốn nhận thực hiện?) then (Không)
  :Quay lại danh sách tìm kiếm;
  stop
else (Có)
  :Xác nhận nhận yêu cầu;
endif

|Hệ thống|
:Kiểm tra lại trạng thái yêu cầu\ntrong một thao tác nguyên tử;

if (Yêu cầu còn PENDING?) then (Không)
  |Hệ thống|
  :Thông báo yêu cầu đã được\nngười khác nhận;
  :Cập nhật lại danh sách\nyêu cầu đang chờ;
  |Người nhận yêu cầu|
  :Tiếp tục tìm kiếm yêu cầu khác;
  stop
else (Có)
  |Hệ thống|
  :Gán người nhận cho yêu cầu;
  :Chuyển trạng thái sang ACCEPTED\nvà lưu lịch sử trạng thái;
  :Loại bỏ yêu cầu khỏi danh sách chờ nhận;
  :Tạo cuộc trao đổi cho hai bên\nvà gửi thông báo đến người đăng;
endif

|Người đăng yêu cầu|
:Nhận thông báo yêu cầu\nđã có người thực hiện;

|Người nhận yêu cầu|
:Xem yêu cầu trong danh sách\n"Yêu cầu đã nhận";
stop

@enduml
