@startuml
!pragma layout smetana
title UC16 – Đánh giá người nhận yêu cầu

skinparam backgroundColor white
skinparam shadowing false
skinparam activity {
  BackgroundColor #EAF7EE
  BorderColor #2E7D4F
  DiamondBackgroundColor #FFF4D6
  DiamondBorderColor #B7791F
  FontColor #18392A
  ArrowColor #3E6250
}

|Người đăng yêu cầu|
start
:Mở yêu cầu đã hoàn thành;
:Chọn "Đánh giá người nhận yêu cầu";

|Hệ thống|
:Kiểm tra điều kiện đánh giá;
if (Được phép đánh giá?) then (Không)
  :Thông báo lý do không thể đánh giá;
  |Người đăng yêu cầu|
  :Xem thông báo;
  stop
else (Có)
  |Hệ thống|
  :Hiển thị biểu mẫu đánh giá;
endif

|Người đăng yêu cầu|
:Chọn số sao;
:Nhập nhận xét và đính kèm hình ảnh (nếu có);
:Gửi đánh giá;

|Hệ thống|
:Kiểm tra nội dung đánh giá;
if (Nội dung hợp lệ?) then (Không)
  :Thông báo nội dung cần điều chỉnh;
  |Người đăng yêu cầu|
  :Chỉnh sửa hoặc hủy gửi đánh giá;
  stop
else (Có)
  |Hệ thống|
  :Lưu đánh giá gắn với yêu cầu;
  :Cập nhật điểm đánh giá của người nhận;
  :Thông báo cho người nhận yêu cầu;
endif

|Người nhận yêu cầu|
:Nhận thông báo và xem đánh giá mới;

|Người đăng yêu cầu|
:Xem đánh giá đã gửi;
stop
@enduml
