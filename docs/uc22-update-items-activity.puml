@startuml
!pragma layout smetana
title UC22 – Cập nhật mặt hàng đã mua

skinparam backgroundColor white
skinparam shadowing false
skinparam activity {
  BackgroundColor #EAF7EE
  BorderColor #2E7D4F
  DiamondBackgroundColor #FFF4D6
  DiamondBorderColor #B7791F
  FontColor #18392A
  ArrowColor #3E6250
}

|Người nhận yêu cầu|
start
:Mở yêu cầu đang ở trạng thái đi chợ;
:Chọn "Cập nhật mặt hàng";

|Hệ thống|
:Hiển thị danh sách mặt hàng cần mua;

repeat
  |Người nhận yêu cầu|
  :Chọn một mặt hàng;
  :Chọn kết quả mua hàng\n(đã mua / hết hàng / thay thế);
  if (Đã mua?) then (Có)
    :Nhập số lượng thực tế và đơn giá;
  else (Không)
    :Nhập ghi chú hoặc thông tin\nsản phẩm thay thế;
    :Đính kèm hình ảnh (nếu có);
  endif
  :Gửi thông tin cập nhật;

  |Hệ thống|
  :Kiểm tra dữ liệu mặt hàng;
  while (Dữ liệu chưa hợp lệ?) is (Có)
    :Thông báo nội dung cần điều chỉnh;
    |Người nhận yêu cầu|
    :Chỉnh sửa và gửi lại thông tin;
    |Hệ thống|
    :Kiểm tra lại dữ liệu;
  endwhile (Không)
  :Lưu kết quả của mặt hàng;
  :Tính lại tổng chi phí tạm tính;
  if (Có thay đổi cần người đăng lưu ý?) then (Có)
    :Gửi thông báo cho người đăng yêu cầu;
  else (Không)
  endif
repeat while (Còn mặt hàng cần cập nhật?) is (Có)
->Không;

|Hệ thống|
:Hiển thị danh sách mặt hàng và\ntổng chi phí tạm tính mới nhất;
|Người nhận yêu cầu|
:Xem kết quả cập nhật;

|Người đăng yêu cầu|
:Nhận thông báo nếu có mặt hàng thay đổi;
stop
@enduml
