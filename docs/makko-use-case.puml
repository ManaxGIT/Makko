@startuml
!pragma layout smetana
title SƠ ĐỒ USE CASE NGHIỆP VỤ CHÍNH CỦA MAKKO

left to right direction
skinparam dpi 180
skinparam pageMargin 16
skinparam shadowing false
skinparam linetype spline
skinparam nodesep 24
skinparam ranksep 32
skinparam ArrowColor #475569
skinparam ArrowThickness 1
skinparam ActorBorderColor #1E3A8A
skinparam ActorFontColor #1E3A8A
skinparam ActorFontSize 12
skinparam UsecaseBorderColor #6D28D9
skinparam UsecaseBackgroundColor #FFFFFF
skinparam UsecaseFontColor #2E1065
skinparam UsecaseFontSize 11
skinparam RectangleBorderColor #64748B
skinparam RectangleBackgroundColor #FCFCFF
skinparam RectangleFontColor #0F172A

actor "Người đăng\nyêu cầu" as Requester
actor "Người nhận\nyêu cầu" as Shopper

rectangle "HỆ THỐNG MAKKO" {
  usecase "Quản lý tài khoản" as Account
  usecase "Xem thông báo" as Notification

  usecase "Tạo yêu cầu\nđi chợ" as CreateRequest
  usecase "Quản lý yêu cầu\nđã đăng" as ManageRequest
  usecase "Theo dõi tiến trình" as TrackRequest

  usecase "Tìm kiếm yêu cầu" as FindRequest
  usecase "Xem chi tiết yêu cầu" as ViewRequest
  usecase "Nhận yêu cầu" as AcceptRequest
  usecase "Thực hiện yêu cầu" as FulfillRequest

  usecase "Trao đổi thông tin" as Chat
  usecase "Ghi nhận hóa đơn\nvà chi phí" as Receipt
  usecase "Xác nhận hoàn thành" as Complete
  usecase "Đánh giá người dùng" as Review
  usecase "Báo cáo sự cố" as Report
}

' Các liên kết đều đi trực tiếp từ actor tới use case
Requester -- Account
Requester -- Notification
Requester -- CreateRequest
Requester -- ManageRequest
Requester -- TrackRequest
Requester -- ViewRequest
Requester -- Chat
Requester -- Receipt
Requester -- Complete
Requester -- Review
Requester -- Report

Shopper -- Account
Shopper -- Notification
Shopper -- FindRequest
Shopper -- ViewRequest
Shopper -- AcceptRequest
Shopper -- FulfillRequest
Shopper -- Chat
Shopper -- Receipt
Shopper -- Complete
Shopper -- Review
Shopper -- Report

FindRequest ..> ViewRequest : <<include>>
AcceptRequest ..> ViewRequest : <<include>>
FulfillRequest ..> Receipt : <<include>>
Review ..> Complete : <<extend>>
Report ..> ViewRequest : <<extend>>

@enduml
