@startuml
!pragma layout smetana
title UC23 – Cung cấp hóa đơn và chi phí

skinparam backgroundColor white
skinparam shadowing false
skinparam activity {
  BackgroundColor #EAF7EE
  BorderColor #2E7D4F
  DiamondBackgroundColor #FFF4D6
  DiamondBorderColor #B7791F
  FontColor #18392A
  ArrowColor #3E6250
}

|Người nhận yêu cầu|
start
:Mở yêu cầu sau khi cập nhật mặt hàng;
:Chọn "Cung cấp hóa đơn và chi phí";

|Hệ thống|
:Hiển thị danh sách mặt hàng, giá thực tế\nvà tổng chi phí tạm tính;

|Người nhận yêu cầu|
:Kiểm tra thông tin mua hàng;
:Điều chỉnh thông tin mặt hàng (nếu cần);
:Tải ảnh hóa đơn;
:Nhập các khoản chi phí phát sinh hợp lệ;
:Gửi thông tin;

|Hệ thống|
:Kiểm tra hóa đơn và dữ liệu chi phí;
while (Thông tin chưa hợp lệ?) is (Có)
  :Thông báo lỗi và nội dung cần bổ sung;
  |Người nhận yêu cầu|
  :Chỉnh sửa hoặc bổ sung thông tin;
  :Gửi lại;
  |Hệ thống|
  :Kiểm tra lại hóa đơn và chi phí;
endwhile (Không)

:Tính tổng tiền mua hàng, phí dịch vụ\nvà các chi phí phát sinh hợp lệ;
:Lưu hóa đơn và thông tin chi phí;
:Đánh dấu đang chờ người đăng xác nhận chi phí;
:Gửi thông báo cho người đăng yêu cầu;

|Người đăng yêu cầu|
:Nhận thông báo có chi phí cần xác nhận;

|Người nhận yêu cầu|
:Xem trạng thái chờ xác nhận;
stop
@enduml
