@startuml
!pragma layout smetana
title UC21 – Cập nhật trạng thái thực hiện yêu cầu

skinparam backgroundColor white
skinparam shadowing false
skinparam activity {
  BackgroundColor #EAF7EE
  BorderColor #2E7D4F
  DiamondBackgroundColor #FFF4D6
  DiamondBorderColor #B7791F
  FontColor #18392A
  ArrowColor #3E6250
}

|Người nhận yêu cầu|
start
:Mở yêu cầu đã nhận;
:Chọn "Cập nhật trạng thái";

|Hệ thống|
:Hiển thị trạng thái hiện tại\nvà các trạng thái kế tiếp hợp lệ;

|Người nhận yêu cầu|
:Chọn trạng thái kế tiếp;
:Nhập ghi chú (nếu có);
:Xác nhận cập nhật;

|Hệ thống|
:Kiểm tra quyền thực hiện, trạng thái yêu cầu\nvà quy tắc chuyển trạng thái;
if (Thông tin cập nhật hợp lệ?) then (Không)
  :Thông báo lý do không thể cập nhật;
  |Người nhận yêu cầu|
  :Xem thông báo và giữ nguyên trạng thái cũ;
  stop
else (Có)
  |Hệ thống|
  :Cập nhật trạng thái mới;
  :Lưu lịch sử gồm trạng thái cũ, trạng thái mới,\nngười cập nhật và thời gian;
  :Gửi thông báo cho người đăng yêu cầu;
endif

|Người đăng yêu cầu|
:Nhận thông báo về tiến độ mới;

|Người nhận yêu cầu|
:Xem trạng thái đã được cập nhật;
stop
@enduml
