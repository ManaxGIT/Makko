@startuml
!pragma layout smetana
title UC17 – Báo cáo vấn đề

skinparam backgroundColor white
skinparam shadowing false
skinparam activity {
  BackgroundColor #EAF7EE
  BorderColor #2E7D4F
  DiamondBackgroundColor #FFF4D6
  DiamondBorderColor #B7791F
  FontColor #18392A
  ArrowColor #3E6250
}

|Người dùng|
start
:Mở yêu cầu có vấn đề;
:Chọn "Báo cáo vấn đề";

|Hệ thống|
:Hiển thị biểu mẫu báo cáo;

|Người dùng|
:Chọn loại vấn đề;
:Nhập nội dung mô tả;
:Đính kèm hình ảnh hoặc tài liệu (nếu có);
:Gửi báo cáo;

|Hệ thống|
:Kiểm tra thông tin báo cáo;
while (Thông tin chưa hợp lệ?) is (Có)
  :Thông báo nội dung cần bổ sung;
  |Người dùng|
  :Chỉnh sửa và gửi lại báo cáo;
  |Hệ thống|
  :Kiểm tra lại thông tin;
endwhile (Không)

:Tạo báo cáo với trạng thái chờ xử lý;
:Liên kết báo cáo với yêu cầu và người gửi;
:Lưu thời gian cùng bằng chứng đính kèm;
:Thông báo đã tiếp nhận báo cáo;
:Gửi thông báo cho quản trị viên;

|Quản trị viên|
:Nhận thông báo có báo cáo mới;

|Người dùng|
:Nhận mã báo cáo và xem trạng thái xử lý;
stop
@enduml
