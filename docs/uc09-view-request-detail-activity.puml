@startuml
!pragma layout smetana
title ACTIVITY DIAGRAM – XEM CHI TIẾT YÊU CẦU (UC09)

skinparam dpi 180
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam activity {
  BackgroundColor #F8F6FF
  BorderColor #7359A6
  FontColor #172033
  DiamondBackgroundColor #FFF7E8
  DiamondBorderColor #C17A1B
  StartColor #654F91
  EndColor #654F91
  BarColor #64748B
}
skinparam partition {
  BorderColor #94A3B8
  FontColor #24324A
  BackgroundColor #FBFCFE
}
skinparam ArrowColor #64748B
skinparam ArrowThickness 1.2

|Tác nhân|
start
:Chọn một yêu cầu\ntừ danh sách phù hợp;

|Hệ thống|
:Tìm yêu cầu theo mã định danh;

if (Yêu cầu tồn tại?) then (Không)
  |Hệ thống|
  :Thông báo yêu cầu không tồn tại\nhoặc đã bị xóa;
  |Tác nhân|
  :Quay lại danh sách;
  stop
else (Có)
  |Hệ thống|
  :Xác định vai trò của tác nhân\nđối với yêu cầu;
endif

|Hệ thống|
:Kiểm tra trạng thái yêu cầu\nvà quyền truy cập;

if (Được phép xem?) then (Không)
  |Hệ thống|
  :Thông báo không có quyền truy cập;
  |Tác nhân|
  :Quay lại danh sách;
  stop
else (Có)
  |Hệ thống|
  :Lấy thông tin yêu cầu, danh sách\nmặt hàng và thông tin giao nhận;
endif

|Hệ thống|
:Lấy trạng thái, lịch sử cập nhật,\nchi phí và thông tin hai bên nếu được phép;
:Xác định các thao tác có thể thực hiện\ntheo vai trò và trạng thái yêu cầu;
:Hiển thị nội dung chi tiết;

|Tác nhân|
:Xem thông tin và lựa chọn\nthao tác tiếp theo nếu cần;
stop

@enduml
